# What aw writes under the checkout; never source.
.aw/

# Agent session files; only agents/, skills/ and plugins/ are source under
# .agents/.
.agents/*
!.agents/agents/
!.agents/skills/
!.agents/plugins/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.mcp.json
.playwright-mcp/

# Build output and environment files.
/target/
.env
.env.*
!.env.example

# Caches of the old Python aw. aw is Rust now and writes none of these, but
# old checkouts still hold them. Remove these lines when the checkouts are clean.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Editors and OS.
.vscode/
.idea/
*.swp
.DS_Store

# Terraform working data; state lives in GCS (infra/gke-test/bootstrap).
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
