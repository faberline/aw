# Bind this workflow ID, Git blob and display job name in review_readiness.
# Replace both placeholders with the reviewed product CI name and AW commit.
name: AW planned test evidence
on:
  workflow_run:
    workflows: ["PRODUCT_CI_WORKFLOW_NAME"]
    types: [completed]
  workflow_dispatch:
    inputs:
      pr:
        description: Pull request number to recheck
        required: true
        type: string
permissions: {}
jobs:
  evidence:
    name: planned test evidence
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
      pull-requests: read
      issues: read
    steps:
      - uses: faberline/aw/.github/actions/issue-ci@REVIEWED_AW_COMMIT
        with:
          operation: planned-produce
