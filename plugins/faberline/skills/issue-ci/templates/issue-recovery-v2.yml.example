# Bind the actual workflow ID and definition blob in the reviewed policy.
# Keep version 2 explicitly disabled until authenticated activation is complete.
# Publishing or running the inactive workflow is not recovery acceptance.
name: Verified issue recovery
on:
  repository_dispatch:
    types: [aw-verified-merge-recover]
  workflow_run:
    workflows: [Issue CI and Claude outcome]
    types: [completed]
    branches: [REPLACE_WITH_DEFAULT_BRANCH]
permissions: {}
concurrency:
  group: issue-ci-handoff
  cancel-in-progress: false
jobs:
  recovery:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: write
      issues: write
      pull-requests: read
      statuses: write
    steps:
      - uses: faberline/aw/.github/actions/verified-issue-recovery@REPLACE_WITH_REVIEWED_FULL_SHA
