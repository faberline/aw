# NOT INSTALLED. Replace AW_REVIEWED_40_HEX after independent shared-code review.
# Register actual workflow IDs/blobs/job names in default-branch policy first.
# Supply a separately reviewed, hash-verified Claude CLI at /usr/local/bin/claude
# on an ephemeral Linux runner. This template never installs a mutable CLI.
name: Claude final review
run-name: AW Claude review PR ${{ github.event.workflow_run.pull_requests[0].number }} head ${{ github.event.workflow_run.head_sha }}
on:
  workflow_run:
    workflows: [REVIEWED_EXISTING_TEST_WORKFLOW_NAME]
    types: [completed]
permissions:
  contents: read
  actions: read
  pull-requests: read
  issues: read
concurrency:
  group: claude-final-review-${{ github.event.workflow_run.pull_requests[0].number || github.run_id }}
  cancel-in-progress: false
jobs:
  preflight:
    runs-on: ubuntu-latest
    outputs:
      eligible: ${{ steps.preflight.outputs.eligible }}
      pr: ${{ steps.preflight.outputs.pr }}
      head: ${{ steps.preflight.outputs.head }}
    steps:
      - uses: faberline/aw/.github/actions/claude-review@AW_REVIEWED_40_HEX
        id: preflight
        with:
          operation: preflight
          pr: ${{ github.event.workflow_run.pull_requests[0].number }}
          head: ${{ github.event.workflow_run.head_sha }}
          review-run: ${{ github.run_id }}
  review:
    needs: preflight
    if: needs.preflight.outputs.eligible == 'true'
    runs-on: ubuntu-latest
    steps:
      # Add only the separately reviewed immutable CLI provisioning step here.
      # Never checkout PR code, restore its caches, install its packages or run
      # its scripts on a credentialed runner. No other step gets this secret.
      - uses: faberline/aw/.github/actions/claude-review@AW_REVIEWED_40_HEX
        env:
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        with:
          operation: review
          pr: ${{ needs.preflight.outputs.pr }}
          head: ${{ needs.preflight.outputs.head }}
          review-run: ${{ github.run_id }}
