# Install with the pinned action, real producer identity and strict provider
# ruleset. Qualification holds prohibit merge but permit verified rejection.
name: Claude review outcome
on:
  workflow_run:
    workflows: [Claude final review]
    types: [requested, in_progress, completed]
  issues:
    types: [edited, reopened, closed, labeled, unlabeled]
  pull_request_target:
    types: [opened, reopened, synchronize, edited, ready_for_review, converted_to_draft]
permissions:
  actions: read
  contents: read
  pull-requests: read
  issues: read
concurrency:
  group: issue-ci-handoff
  cancel-in-progress: false
jobs:
  native-auto-merge:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: write
      pull-requests: write
      statuses: write
      issues: write
    steps:
      # No checkout, model, Claude credential, PR artifact or PR program.
      # Every wake recomputes all open PRs, including displaced pending wakes.
      - uses: faberline/aw/.github/actions/native-auto-merge@AW_REVIEWED_40_HEX
