# Copy ONLY after choosing the consumer's actual required workflows/jobs.
# This is a trusted default-branch workflow, NOT pull_request_target execution.
name: Issue CI handoff
on:
  workflow_run:
    workflows: ["PR unit", "PR cloud"] # replace with actual workflow display names
    types: [completed]
permissions:
  actions: read
  contents: read
  pull-requests: read
  issues: write
# All handoff invocations must share this group. Do not cancel active writers.
concurrency:
  group: issue-ci-handoff
  cancel-in-progress: false
jobs:
  handoff:
    if: github.event.workflow_run.event == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      # Pin actions/checkout to a reviewed immutable commit in the consumer.
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - name: Reconcile current PRs using trusted controller and config
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          RUN_ID: ${{ github.event.workflow_run.id }}
          HEAD: ${{ github.event.workflow_run.head_sha }}
        shell: bash
        run: |
          set -euo pipefail
          # Metadata only; never download artifacts or check out/evaluate PR code.
          gh api "repos/$REPO/actions/runs/$RUN_ID" --jq '.pull_requests[].number' |
          while read -r pr; do
            python3 plugins/faberline/skills/issue-ci/scripts/handoff.py \
              --repo "$REPO" --pr "$pr" --head "$HEAD" --run-id "$RUN_ID" \
              --config .github/issue-ci-required-gates.json --apply
          done
